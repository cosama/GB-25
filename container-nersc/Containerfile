# syntax=docker/dockerfile:1
ARG CUDA_IMAGE=docker.io/nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04
FROM ${CUDA_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /opt
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update &&     apt-get install --yes --no-install-recommends         autoconf         automake         bc         bison         build-essential         ca-certificates         cmake         curl         flex         git         libblas-dev         libboost-all-dev         libbz2-dev         libcurl4-openssl-dev         libedit-dev         libevent-dev         libfftw3-dev         libgmp-dev         libgsl-dev         libhdf5-serial-dev         libicu-dev         liblapack-dev         libtool         libxc-dev         libyaml-cpp-dev         libzmq3-dev         make         python-is-python3         python3-cffi         python3-dev         python3-jsonschema         python3-pip         python3-ply         python3-yaml         unzip         uuid-dev         wget         zlib1g-dev &&     rm -rf /var/lib/apt/lists/*

# Local MPI is only a build/local fallback. On Perlmutter, podman-hpc should
# inject the optimized NERSC/Cray MPI stack at runtime.
ARG MPICH_VERSION=4.2.2
ARG MPICH_PREFIX=mpich-${MPICH_VERSION}
RUN wget https://www.mpich.org/static/downloads/${MPICH_VERSION}/${MPICH_PREFIX}.tar.gz &&     tar xzf ${MPICH_PREFIX}.tar.gz &&     cd ${MPICH_PREFIX} &&     ./configure --prefix=/opt/mpich/install &&     make -j "$(nproc)" &&     make install &&     cd /opt &&     rm -rf ${MPICH_PREFIX} ${MPICH_PREFIX}.tar.gz
ENV PATH=/opt/mpich/install/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/mpich/install/lib:${LD_LIBRARY_PATH}
RUN ldconfig

# Reactant_jll's CUDA artifact selection can need libcuda at package build time.
# During image build only the CUDA stubs are available; the real driver library
# is injected by the GPU runtime on NERSC.
ENV PATH=/usr/local/cuda/lib64/stubs:/usr/local/cuda/targets/x86_64-linux/lib/stubs:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:/usr/local/cuda/targets/x86_64-linux/lib/stubs:${LD_LIBRARY_PATH}

ARG EIGEN_VERSION=5.0.1
RUN wget https://gitlab.com/libeigen/eigen/-/archive/${EIGEN_VERSION}/eigen-${EIGEN_VERSION}.tar.gz &&     tar xzf eigen-${EIGEN_VERSION}.tar.gz &&     mv eigen-${EIGEN_VERSION} eigen &&     rm eigen-${EIGEN_VERSION}.tar.gz &&     cmake -S /opt/eigen -B /opt/eigen/build -DCMAKE_INSTALL_PREFIX=/opt/eigen/install &&     cmake --build /opt/eigen/build --target blas --parallel "$(nproc)" &&     cmake --build /opt/eigen/build --target lapack --parallel "$(nproc)" &&     cmake --install /opt/eigen/build
ENV PATH=/opt/eigen/install/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/eigen/install/lib:${LD_LIBRARY_PATH}

ARG JULIA_VERSION=1.12.6
ENV JULIA_DEPOT_PATH=/usr/local/julia_depot
ENV JULIAUP_DEPOT_PATH=/usr/local/julia
RUN curl -fsSL https://install.julialang.org -o /tmp/install-juliaup.sh &&     sh /tmp/install-juliaup.sh --yes --path /usr/local/julia --default-channel ${JULIA_VERSION} &&     rm /tmp/install-juliaup.sh
ENV PATH=/usr/local/julia/bin:${PATH}

WORKDIR /opt/GB-25
ENV JULIA_PROJECT=/opt/GB-25
ENV JULIA_CUDA_USE_BINARYBUILDER=false
ENV JULIA_PKG_PRECOMPILE_AUTO=0

ARG NERSC_LOCAL_PREFERENCES=container-nersc/LocalPreferences.cuda12.toml

COPY Project.toml ./
COPY container-nersc/Manifest.toml ./Manifest.toml
COPY container-nersc/LocalPreferences.cuda12.toml container-nersc/LocalPreferences.cuda13.toml ./container-nersc/
COPY src ./src
COPY ext ./ext
COPY sharding ./sharding
COPY simulations ./simulations
COPY correctness ./correctness

# Materialize the locked environment only. Do not import or precompile Julia
# packages here: compilation is architecture-sensitive and must happen on the
# target GPU/runtime environment.
RUN cp "${NERSC_LOCAL_PREFERENCES}" LocalPreferences.toml &&     test -f Manifest.toml &&     test -f LocalPreferences.toml &&     test -f src/GordonBell25.jl &&     julia --startup-file=no --compiled-modules=no -e 'using Pkg; Pkg.activate("/opt/GB-25"); Pkg.instantiate()'

CMD ["julia", "--project=/opt/GB-25"]
